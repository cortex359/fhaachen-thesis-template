\begingroup%
\makeatletter%
\begin{pgfpicture}%
\pgfpathrectangle{\pgfpointorigin}{\pgfpoint{4.000000in}{3.000000in}}%
\pgfusepath{use as bounding box, clip}%
%% draw axes
\pgfpathmoveto{\pgfpoint{0.500000in}{0.400000in}}%
\pgfpathlineto{\pgfpoint{3.700000in}{0.400000in}}%
\pgfpathlineto{\pgfpoint{3.700000in}{2.700000in}}%
\pgfpathlineto{\pgfpoint{0.500000in}{2.700000in}}%
\pgfpathclose%
\pgfsetstrokecolor{black}%
\pgfsetlinewidth{0.500000pt}%
\pgfusepath{stroke}%
%% draw data line
\pgfpathmoveto{\pgfpoint{0.700000in}{0.600000in}}%
\pgfpathlineto{\pgfpoint{1.500000in}{2.500000in}}%
\pgfpathlineto{\pgfpoint{2.300000in}{1.200000in}}%
\pgfpathlineto{\pgfpoint{3.100000in}{1.800000in}}%
\pgfsetstrokecolor{blue}%
\pgfsetlinewidth{1.000000pt}%
\pgfusepath{stroke}%
%% x-axis label
\pgftext[at=\pgfpoint{2.100000in}{0.100000in}]{X Axis}%
%% y-axis label
\pgftext[at=\pgfpoint{0.150000in}{1.550000in},rotate=90]{Y Axis}%
%% title
\pgftext[at=\pgfpoint{2.100000in}{2.850000in}]{Example Plot}%
\end{pgfpicture}%
\makeatother%
